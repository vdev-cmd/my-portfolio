# Copy to `.env.local` for local production-like builds. Never commit real secrets here —
# these values are baked into public HTML anyway.

# Public URL where the site is served. Drives the Vite `base`, canonical URL, Open Graph URLs,
# JSON-LD, sitemap.xml and robots.txt. Leave unset to omit all of those absolute-URL tags.
#   Project Pages:  https://<user>.github.io/<repo>
#   User Pages:     https://<user>.github.io
#   Custom domain:  https://example.com
# The GitHub Actions workflow sets this automatically from the Pages configuration.
VITE_SITE_URL=

# Optional: override the base path (defaults to the pathname of VITE_SITE_URL, or "/").
VITE_BASE=
